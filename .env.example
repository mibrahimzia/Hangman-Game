# Local development example. Copy to `.env` (which is git-ignored) and set real values.
# Production on Cloudflare Workers uses `wrangler secret put SECRET_KEY` instead.
SECRET_KEY=change-me-to-a-long-random-value
FLASK_ENV=development
PORT=5000
# Optional: override local SQLite path (default: ./instance/hangman.db)
# SQLITE_PATH=./instance/hangman.db
